# Resend (https://resend.com) — required to send the email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# A sender on a domain verified in Resend, e.g. "Catch <catch@yourdomain.com>"
NOTIFY_FROM_EMAIL=notes@yourdomain.com

# Optional fallback inbox. Normally leave this unset: he picks (and confirms)
# his own address inside the app.
# NOTE_RECIPIENT=

# Optional: signs confirmed addresses. Defaults to RESEND_API_KEY.
# CATCH_SECRET=some-long-random-string

# Anthropic (https://console.anthropic.com) — optional.
# Used to generate the two-word subject summary. If omitted, the app falls
# back to the first two words of the note.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
