# Resend (https://resend.com) — required to send the email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# A verified Resend sender address, e.g. "Voice Note <notes@yourdomain.com>"
NOTIFY_FROM_EMAIL=notes@yourdomain.com

# Where notes are emailed (optional — defaults to devinfarren@gmail.com)
NOTE_RECIPIENT=devinfarren@gmail.com

# Anthropic (https://console.anthropic.com) — optional.
# Used to generate the two-word subject summary. If omitted, the app falls
# back to the first two words of the note.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
